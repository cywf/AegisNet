# .gitignore

# Environment files
.env
.env.local
.env.*.local
*.env

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Build outputs
dist/
build/
*.egg-info/
.eggs/
target/

# Terraform
infra/terraform/.terraform/
infra/terraform/.terraform.lock.hcl
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
infra/terraform/tfplan
infra/terraform/crash.log
infra/terraform/.terraformrc
infra/terraform/terraform.rc

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Docker
docker-compose.override.yml

# Kubernetes
*.kubeconfig

# Temporary files
tmp/
temp/
*.tmp
.cache/

# OS files
Thumbs.db
.DS_Store

# Security
*.pem
*.key
*.crt
*.p12
credentials.json
secrets.yaml

# Test coverage
coverage/
*.cover
.coverage
htmlcov/
.pytest_cache/

# CI/CD
.github/workflows/*.local.yml
