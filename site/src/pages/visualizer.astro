---
import Layout from '../layouts/Layout.astro';
import MermaidViewer from '../components/MermaidViewer';
---

<Layout title="Visualizer - AegisNet" description="Interactive Mermaid diagram visualizer">
  <div class="space-y-6">
    <div class="prose max-w-none">
      <h1>Project Visualizer</h1>
      <p>Interactive visualization of project diagrams and architecture using Mermaid.</p>
    </div>
    
    <MermaidViewer client:load />
  </div>
</Layout>
